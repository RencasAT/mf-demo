# @atbo/mf-kit se instala del Package Registry de GitLab: es el ÚNICO
# acoplamiento en build-time con el host.
#
# El token NO va en el repositorio (esto acaba en GitHub). Se toma del entorno:
#   local  -> export NPM_TOKEN=<token con scope read_api>
#   Vercel -> Settings > Environment Variables > NPM_TOKEN
@atbo:registry=https://repository.kurax.at/api/v4/projects/203/packages/npm/
//repository.kurax.at/api/v4/projects/203/packages/npm/:_authToken=${NPM_TOKEN}
